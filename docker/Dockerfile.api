
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements-u2.txt .
RUN pip install --no-cache-dir -r requirements-u2.txt

COPY src/inference.py ./src/inference.py

RUN useradd --create-home --uid 1000 apiuser \
    && chown -R apiuser:apiuser /app

USER apiuser

EXPOSE 8000

CMD ["uvicorn", "src.inference:app", "--host", "0.0.0.0", "--port", "8000"]
